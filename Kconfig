mainmenu "LED Module Application"

menu "LED Module Configuration"

config LED_PERIOD_SLOW_MS
	int "Period for SLOW pattern (ms)"
	default 1000
	range 10 100000
	help
	  Blink period for the slow pattern in milliseconds.

config LED_PERIOD_NORMAL_MS
	int "Period for NORMAL pattern (ms)"
	default 500
	range 10 100000
	help
	  Blink period for the normal pattern in milliseconds.

config LED_PERIOD_FAST_MS
	int "Period for FAST pattern (ms)"
	default 200
	range 10 100000
	help
	  Blink period for the fast pattern in milliseconds.

module = LED
module-str = led
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
